{
  "manifest_version": 3,
  "name": "ApplyNest",
  "description": "Save job application details once, then copy or fill them anywhere quickly.",
  "version": "1.1.1",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "ApplyNest",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Option+J"
      },
      "description": "Open ApplyNest"
    },
    "toggle-side-panel": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Option+J"
      },
      "description": "Open ApplyNest side panel (Alt+J)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.linkedin.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.workday.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.naukri.com/*",
        "*://*.indeed.com/*",
        "*://*.instahyre.com/*",
        "*://*.wellfound.com/*",
        "*://*.angel.co/*",
        "*://*.glassdoor.com/*",
        "*://*.dice.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.monster.com/*",
        "*://*.hired.com/*",
        "*://*.simplyhired.com/*",
        "*://*.careerbuilder.com/*",
        "*://*.internshala.com/*",
        "*://*.hirist.com/*",
        "*://*.cutshort.io/*",
        "*://*.turing.com/*",
        "*://*.toptal.com/*",
        "*://*.remoteok.com/*",
        "*://*.weworkremotely.com/*",
        "*://*.flexjobs.com/*",
        "*://*.jobs.lever.co/*",
        "*://*.boards.greenhouse.io/*",
        "*://*.apply.workable.com/*"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}